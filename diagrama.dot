digraph G {
  node [shape=record];
  rankdir=BT;
  VehiculoAutonomo [label="{ VehiculoAutonomo | __init__ | mover | calcular_consumo }"];
  AutomovilElectrico [label="{ AutomovilElectrico | __init__ | calcular_consumo | mover }"];
  AutomovilElectrico -> VehiculoAutonomo [arrowhead=empty];
  Dron [label="{ Dron | __init__ | calcular_consumo | mover }"];
  Dron -> VehiculoAutonomo [arrowhead=empty];
  RobotTerrestre [label="{ RobotTerrestre | __init__ | calcular_consumo | mover }"];
  RobotTerrestre -> VehiculoAutonomo [arrowhead=empty];
}
